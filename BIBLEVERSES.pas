{ Справка 
5 - Пятекнижие Моисеева
10 - Помощь
}

PROGRAM BIBLEPASSAGES;

VAR
	COMMAND: INTEGER;
	WHAT_BOOK: INTEGER;
	WHAT_GLAVA: INTEGER;
	WHAT_STIH: INTEGER;

BEGIN
	WRITE('Команда: ');
	READLN(COMMAND);
	IF COMMAND = 5 THEN
	BEGIN
		WRITE('Какая книга (1 для "Бытие") ');
		READLN(WHAT_BOOK);
		IF WHAT_BOOK = 1 THEN
		BEGIN
			WRITE('Какая глава (1, 2..., 30) ');
			READLN(WHAT_GLAVA);
			IF WHAT_GLAVA = 1 THEN
			BEGIN
				WRITE('Какой стих (1, 2..., 31) ');
				READLN(WHAT_STIH);
				IF WHAT_STIH = 1 THEN
					WRITELN('В начале сотворил Бог небо и землю.')
				ELSE IF WHAT_STIH = 2 THEN
					WRITELN('Земля же была безвидна и пуста, и тьма над бездною, и Дух Божий носился над водою.')
				ELSE IF WHAT_STIH = 3 THEN
					WRITELN('И сказал Бог: да будет свет. И стал свет.')
				ELSE IF WHAT_STIH = 4 THEN
					WRITELN('И увидел Бог свет, что он хорош, и отделил Бог свет от тьмы.')
				ELSE IF WHAT_STIH = 5 THEN
					WRITELN('И назвал Бог свет днём, а тьму ночью. И был вечер, и было утро: день один.')
				ELSE IF WHAT_STIH = 6 THEN
					WRITELN('И сказал Бог: да будет твердь посреди воды, и да отделяет она воду от воды. И стало так.')
				ELSE IF WHAT_STIH = 7 THEN
					WRITELN('И создал Бог твердь, и отделил воду, которая под твердью, от воды, которая над твердью. И стало так.')
				ELSE IF WHAT_STIH = 8 THEN
					WRITELN('И назвал Бог твердь небом. И увидел Бог, что это хорошо. И был вечер, и было утро: день второй.')
				ELSE IF WHAT_STIH = 9 THEN
					WRITELN('И сказал Бог: да соберётся вода, которая под небом, в одно место, и да явится суша. И стало так. И собралась вода под небом в свои места, и явилась суша.')
				ELSE IF WHAT_STIH = 10 THEN
					WRITELN('И назвал Бог сушу землёю, а собрание вод назвал морями. И увидел Бог, что это хорошо.')
				ELSE IF WHAT_STIH = 11 THEN
					WRITELN('И сказал Бог: да произрастит земля зелень, траву, сеющую семя по роду и по подобию её, и дерево плодовитое, приносящее плод, в котором семя его по роду его на земле. И стало так.')
				ELSE IF WHAT_STIH = 12 THEN
					WRITELN('И произвела земля зелень, траву, сеющую семя по роду и по подобию её, и дерево плодовитое, приносящее плод, в котором семя его по роду его на земле. И увидел Бог, что это хорошо.')
				ELSE IF WHAT_STIH = 13 THEN
					WRITELN('И был вечер, и было утро: день третий.')
				ELSE IF WHAT_STIH = 14 THEN
					WRITELN('И сказал Бог: да будут светила на тверди небесной для освещения земли и для отделения дня от ночи, и для знамений, и времён, и дней, и годов;')
				ELSE IF WHAT_STIH = 15 THEN
					WRITELN('и да будут они светильниками на тверди небесной, чтобы светить на землю. И стало так.')
				ELSE IF WHAT_STIH = 16 THEN
					WRITELN('И создал Бог два светила великие: светило большее, для управления днём, и светило меньшее, для управления ночью, и звёзды;')
				ELSE IF WHAT_STIH = 17 THEN
					WRITELN('и поставил их Бог на тверди небесной, чтобы светить на землю,')
				ELSE IF WHAT_STIH = 18 THEN
					WRITELN('и управлять днём и ночью, и отделять свет от тьмы. И увидел Бог, что это хорошо.')
				ELSE IF WHAT_STIH = 19 THEN
					WRITELN('И был вечер, и было утро: день четвёртый.')
				ELSE IF WHAT_STIH = 20 THEN
					WRITELN('И сказал Бог: да произведёт вода пресмыкающихся, душу живую; и птицы да полетят над землёю, по тверди небесной. И стало так.')
				ELSE IF WHAT_STIH = 21 THEN
					WRITELN('И сотворил Бог рыб больших и всякую душу животных пресмыкающихся, которых произвела вода, по роду их, и всякую птицу пернатую по роду её. И увидел Бог, что это хорошо.')
				ELSE IF WHAT_STIH = 22 THEN
					WRITELN('И благословил их Бог, говоря: плодитесь и размножайтесь, и наполняйте воды в морях, и птицы да размножаются на земле.')
				ELSE IF WHAT_STIH = 23 THEN
					WRITELN('И был вечер, и было утро: день пятый.')
				ELSE IF WHAT_STIH = 24 THEN
					WRITELN('И сказал Бог: да произведёт земля душу живую по роду её, скотов, и гадов, и зверей земных по роду их. И стало так.')
				ELSE IF WHAT_STIH = 25 THEN
					WRITELN('И создал Бог зверей земных по роду их, и скот по роду его, и всех гадов земных по роду их. И увидел Бог, что это хорошо.')
				ELSE IF WHAT_STIH = 26 THEN
					WRITELN('И сказал Бог: сотворим человека по образу Нашему и подобию Нашему, и да владычествуют они над рыбами морскими, и над птицами небесными, и над зверями, и над скотом, и над всею землёю, и над всеми гадами, пресмыкающимися по земле.')
				ELSE IF WHAT_STIH = 27 THEN
					WRITELN('И сотворил Бог человека по образу Своему, по образу Божию сотворил его; мужчину и женщину сотворил их.')
				ELSE IF WHAT_STIH = 28 THEN
					WRITELN('И благословил их Бог, и сказал им Бог: плодитесь и размножайтесь, и наполняйте землю, и обладайте ею, и владычествуйте над рыбами морскими и над зверями, и над птицами небесными, и над всяким скотом, и над всею землёю, и над всяким животным, пресмыкающимся по земле.')
				ELSE IF WHAT_STIH = 29 THEN
					WRITELN('И сказал Бог: вот, Я дал вам всякую траву, сеющую семя, какая есть на всей земле, и всякое дерево, у которого плод древесный, сеющий семя; - вам сие будет в пищу;')
				ELSE IF WHAT_STIH = 30 THEN
					WRITELN('а всем зверям земным, и всем птицам небесным. и всякому гаду, пресмыкающемуся по земле, в котором душа живая, дал Я всю зелень травную в пищу. И стало так.')
				ELSE IF WHAT_STIH = 31 THEN
					WRITELN('И увидел Бог всё, что Он создал, и вот, хорошо весьма. И был вечер, и было утро: день шестой.')
				ELSE WRITELN('NOT FOUND');
			END
			ELSE IF WHAT_GLAVA = 2 THEN
			BEGIN
				WRITE('Какой стих (1, 2..., 31) ');
				READLN(WHAT_STIH);
				IF WHAT_STIH = 1 THEN
					WRITELN('Так совершены небо и земля и всё воинство их.')
				ELSE WRITELN('NOT FOUND');
			END
			ELSE WRITELN('NOT FOUND');
		END
		ELSE WRITELN('NOT FOUND'); 
	END
	ELSE IF COMMAND = 10 THEN
	BEGIN
		WRITELN('5 - Пятикнижие Моисея.');
	END
	ELSE WRITELN('NOT FOUND');
END.
